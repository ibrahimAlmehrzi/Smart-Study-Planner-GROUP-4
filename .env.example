# Copy this file to .env and change the values. .env is ignored by Git.

# Long random text used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Database. Leave the SQLite line for a quick local run, or use the MySQL line.
DATABASE_URL=sqlite:///instance/planner.db
# DATABASE_URL=mysql://planner_user:your_password@localhost:3306/smart_study_planner

# Minutes a login stays valid (NFR-09)
TOKEN_MINUTES=30

# Background jobs: reminders, missed-session check, deadline alerts, weekly summary (1 = on, 0 = off)
ENABLE_JOBS=1
JOB_INTERVAL_SECONDS=60

# Web server address used by "python manage.py run"
HOST=127.0.0.1
PORT=5000
